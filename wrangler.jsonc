{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gang-muzik",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // trang HTML qua worker để chèn meta SEO; còn lại phục vụ tĩnh
    "run_worker_first": ["/api/*", "/", "/s/*", "/privacy", "/terms", "/robots.txt", "/sitemap.xml"]
  },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gang-muzik",
      "database_id": "8e7b9c58-6787-4e9a-88b2-dd61feb2faa0",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "gang-muzik-files" }]
}
